# Supabase — Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret cron-job.org must send as the X-Cron-Secret header
# when calling POST /api/scrape/run
CRON_SECRET=change-me-to-a-long-random-string

# true in production (Render); set HEADLESS=false locally for the headed demo
HEADLESS=true

# Comma-separated list of allowed frontend origins, or "*" for any
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Port Express listens on (Render sets this automatically; used for local dev)
PORT=3001

# Base URL of the storefront being tracked (rarely needs changing)
STORE_BASE_URL=https://demo.inelabteamdev.com

# Retry tuning (optional — sensible defaults if omitted)
MAX_SCRAPE_ATTEMPTS=3
SCRAPE_BASE_DELAY_MS=1000
